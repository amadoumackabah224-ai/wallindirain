# Copiez ce fichier en .env puis remplacez TOUTES les valeurs. Ne publiez jamais .env.
# Générer un mot de passe fort :  openssl rand -base64 24

DOMAIN=app.exemple.com                 # votre nom de domaine (doit pointer vers ce serveur)
DB_OWNER_PASSWORD=changez-moi          # compte propriétaire de la base (migrations, sauvegardes)
DB_APP_PASSWORD=changez-moi-aussi      # compte de l'application (droits limités)
CONTACT_PHONE=624390707                # numéro d'aide affiché dans l'application

# Messages au client (code de livraison, mot de passe oublié)
MESSAGE_PROVIDER=simulated             # simulated = enregistrés sans envoi ; whatsapp = envoi réel
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Sauvegardes quotidiennes
BACKUP_KEEP_DAYS=30
BACKUP_HOUR_UTC=2
BACKUP_PATH=./backups                  # idéalement un disque ou un montage distinct du serveur principal
